ErrorDocument 404 /guiaempresarial.pe/404.php

Options +FollowSymLinks -Indexes -MultiViews
ServerSignature Off

# Protección contra acceso a archivos por extensión
<FilesMatch "\.(log|sql|md|git|env)$">
    Require all denied
</FilesMatch>

# Proteger archivos específicos
<Files "README.md">
    Require all denied
</Files>

# Headers de seguridad adicionales
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /guiaempresarial.pe/
    
    RewriteRule ^negocio/([^/]+)/?$ empresas.php?slug=$1 [L,QSA]
    
    RewriteRule ^rubro/([^/]+)/?$ empresas.php?cat_slug=$1 [L,QSA]

    # Redirección de archivos no encontrados
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ 404.php [L]
</IfModule>
