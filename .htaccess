ErrorDocument 403 /guiaempresarial.pe/403.php
ErrorDocument 404 /guiaempresarial.pe/404.php
ErrorDocument 500 /guiaempresarial.pe/500.php

Options +FollowSymLinks -Indexes -MultiViews
ServerSignature Off

<FilesMatch "\.(log|sql|md|git|env)$">
    Require all denied
</FilesMatch>

<Files ".env">
    Require all denied
</Files>

<Files "README.md">
    Require all denied
</Files>

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /guiaempresarial.pe/
    DirectoryIndex index.php

    RewriteCond %{DOCUMENT_ROOT}/guiaempresarial.pe/mantenimiento.flag -f
    RewriteCond %{REQUEST_URI} !^/guiaempresarial.pe/mantenimiento\.php$
    RewriteCond %{REQUEST_URI} !^/guiaempresarial.pe/assets/
    RewriteCond %{REQUEST_URI} !^/guiaempresarial.pe/login
    RewriteCond %{REQUEST_URI} !^/guiaempresarial.pe/login_usuario
    RewriteCond %{REQUEST_URI} !^/guiaempresarial.pe/registro_usuario
    RewriteCond %{REQUEST_URI} !^/guiaempresarial.pe/logout
    RewriteRule ^(.*)$ mantenimiento.php [L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*)/index(\.php)? [NC]
    RewriteRule ^ %1/ [R=301,L]

    RewriteRule ^negocio/([^/]+)/?$ empresas.php?slug=$1 [L,QSA]
    RewriteRule ^rubro/([^/]+)/?$ empresas.php?cat_slug=$1 [L,QSA]

    RewriteCond %{THE_REQUEST} \s([^.]+)\.php [NC]
    RewriteCond %1 !^(negocio|rubro|login) [NC]
    RewriteRule ^ %1 [R=301,L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/guiaempresarial.pe/$1.php -f
    RewriteRule ^(.*?)/?$ $1.php [L,QSA]

    RewriteRule ^login/?$ index.php [R=302,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ 404.php [L]
</IfModule>
